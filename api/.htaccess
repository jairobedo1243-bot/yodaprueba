# Nadie debe poder descargar las credenciales ni los scripts de apoyo
<FilesMatch "^(\.env.*|config\.php|db\.php|helpers\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
